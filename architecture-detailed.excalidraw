    {"id":"b5l","type":"text","x":210,"y":550,"width":600,"height":130,"text":"services/agent.py                                 (ReAct Agent)\n\n_create_llm(provider, ollama_model)\n  -> ChatGroq | ChatOllama\n_build_executor(provider, model, constitution_tree, bns_tree)\n  -> AgentExecutor (max_iterations=20)\nrun_agent_stream(query, provider, ...) -> AsyncGenerator[SSE]\n  yields: {token:\"...\"} ... {done:true, output:\"...\"}","fontSize":13,"fontFamily":3,"textAlign":"left","strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"roughness":0,"opacity":100,"angle":0,"seed":53,"version":1,"groupIds":[],"boundElements":[],"roundness":null},

