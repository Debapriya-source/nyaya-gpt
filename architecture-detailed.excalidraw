    {"id":"b7l","type":"text","x":50,"y":880,"width":920,"height":170,"text":"services/tree_index.py                               (Document Tree Builder)\n\nTreeNode(id, title, summary, level, page_start, page_end, content, children[])\n  .to_dict() / .from_dict()\n_inject_page_markers(pages) -> str        _page_range(text) -> (start, end)       _strip_markers(text) -> str\n_extract_pages(pdf_path) -> [(page_num, text)]\n_build_constitution_tree(pages) -> TreeNode    regex: PART + Article headings\n_build_bns_tree(pages) -> TreeNode             regex: CHAPTER + Section bodies, TOC title lookup\n_clean_title(title) -> str                     removes PDF artifacts\nbuild_tree(doc_type, pdf_path) -> TreeNode\nload_or_build_tree(doc_type, filename)         caches as JSON in db/\nfind_node(tree, node_id) -> TreeNode | None    DFS search\nget_node_content(tree, node_id) -> str         full section text","fontSize":12,"fontFamily":3,"textAlign":"left","strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"roughness":0,"opacity":100,"angle":0,"seed":61,"version":1,"groupIds":[],"boundElements":[],"roundness":null},

